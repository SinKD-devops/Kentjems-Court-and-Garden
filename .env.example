# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# ── Supabase ──────────────────────────────────────────────
# Safe to expose: ships in the browser bundle, guarded by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SERVER ONLY. Bypasses row-level security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# ── Semaphore (sign-in + booking notifications) ───────────
SEMAPHORE_API_KEY=
SEMAPHORE_API_URL=https://api.semaphore.co/api/v4
SEMAPHORE_SENDER_NAME=

# ── Weather (OpenWeather free tier) ───────────────────────
OPENWEATHER_API_KEY=

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Direct Postgres connection (migrations + schema tests) ────
# Supabase → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Supabase Send SMS auth hook secret (Authentication -> Hooks)
SUPABASE_SMS_HOOK_SECRET=

# Shared secret for the scheduled endpoints (purge-proofs, sms-balance)
CRON_SECRET=
