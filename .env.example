# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# ── Supabase ──────────────────────────────────────────────
# Safe to expose: ships in the browser bundle, guarded by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SERVER ONLY. Bypasses row-level security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# ── PhilSMS (OTP + booking notifications) ─────────────────
PHILSMS_API_TOKEN=
PHILSMS_SENDER_ID=

# ── Web push (VAPID) ──────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Weather (OpenWeather free tier) ───────────────────────
OPENWEATHER_API_KEY=

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
TZ=Asia/Manila
